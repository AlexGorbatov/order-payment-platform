{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.altronixsoft.com/opp/events/PaymentRefundFailed.v1.json",
  "title": "PaymentRefundFailed v1",
  "description": "A refund failed at the provider.",
  "allOf": [
    {
      "$ref": "envelope.v1.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "PaymentRefundFailed"
    },
    "eventVersion": {
      "const": 1
    },
    "aggregateType": {
      "const": "Payment"
    },
    "producer": {
      "const": "payment-service"
    },
    "payload": {
      "$ref": "#/$defs/payload"
    }
  },
  "$defs": {
    "payload": {
      "type": "object",
      "required": [
        "paymentId",
        "orderId",
        "refundRequestId",
        "failureReason"
      ],
      "properties": {
        "paymentId": {
          "type": "string",
          "format": "uuid",
          "description": "Payment aggregate id."
        },
        "orderId": {
          "type": "string",
          "format": "uuid",
          "description": "Order the event belongs to; also the Kafka partition key."
        },
        "refundRequestId": {
          "type": "string",
          "format": "uuid",
          "description": "Idempotency id of the refund request."
        },
        "failureReason": {
          "type": "string",
          "minLength": 1,
          "description": "Sanitized failure reason."
        }
      }
    }
  }
}
