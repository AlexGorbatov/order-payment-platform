# Copy to .env (gitignored) and fill in locally. Never commit real values.
# Stripe TEST MODE ONLY: LiveModeGuard refuses to start unless the key starts with sk_test_ or rk_test_.

# Stripe API key (test mode) — only needed for the `stripe-test` profile / manual demo
STRIPE_API_KEY=sk_test_replace_me

# Webhook signing secret(s), comma-separated to support rotation (from `stripe listen` or the local test signer)
STRIPE_WEBHOOK_SECRETS=whsec_replace_me

# Keycloak confidential client for ops scripts (client-credentials)
KEYCLOAK_OPS_CLIENT_SECRET=replace_me

# Local PostgreSQL (docker compose)
POSTGRES_USER=replace_me
POSTGRES_PASSWORD=replace_me
