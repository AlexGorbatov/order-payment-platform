{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.altronixsoft.com/opp/events/PaymentActionRequired.v1.json",
  "title": "PaymentActionRequired v1",
  "description": "The customer must complete an additional step (e.g. 3-D Secure).",
  "allOf": [
    {
      "$ref": "envelope.v1.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "PaymentActionRequired"
    },
    "eventVersion": {
      "const": 1
    },
    "aggregateType": {
      "const": "Payment"
    },
    "producer": {
      "const": "payment-service"
    },
    "payload": {
      "$ref": "#/$defs/payload"
    }
  },
  "$defs": {
    "payload": {
      "type": "object",
      "required": [
        "paymentId",
        "orderId"
      ],
      "properties": {
        "paymentId": {
          "type": "string",
          "format": "uuid",
          "description": "Payment aggregate id."
        },
        "orderId": {
          "type": "string",
          "format": "uuid",
          "description": "Order the event belongs to; also the Kafka partition key."
        }
      }
    }
  }
}
