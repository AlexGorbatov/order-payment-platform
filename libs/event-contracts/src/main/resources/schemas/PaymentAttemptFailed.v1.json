{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.altronixsoft.com/opp/events/PaymentAttemptFailed.v1.json",
  "title": "PaymentAttemptFailed v1",
  "description": "A payment attempt failed; the customer may retry.",
  "allOf": [
    {
      "$ref": "envelope.v1.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "PaymentAttemptFailed"
    },
    "eventVersion": {
      "const": 1
    },
    "aggregateType": {
      "const": "Payment"
    },
    "producer": {
      "const": "payment-service"
    },
    "payload": {
      "$ref": "#/$defs/payload"
    }
  },
  "$defs": {
    "payload": {
      "type": "object",
      "required": [
        "paymentId",
        "orderId",
        "errorCode"
      ],
      "properties": {
        "paymentId": {
          "type": "string",
          "format": "uuid",
          "description": "Payment aggregate id."
        },
        "orderId": {
          "type": "string",
          "format": "uuid",
          "description": "Order the event belongs to; also the Kafka partition key."
        },
        "errorCode": {
          "type": "string",
          "minLength": 1,
          "description": "Sanitized error code."
        },
        "declineCode": {
          "type": "string",
          "minLength": 1,
          "description": "Sanitized decline code; omitted when the provider gave none."
        }
      }
    }
  }
}
