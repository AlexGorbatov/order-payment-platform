# Copy to .env (gitignored) in the repo root and adjust locally. Never commit real values.
# scripts/*.sh pass this file to docker compose; every variable below also has a dev default in infra/docker-compose.yml.

# ----------------------------------------------------------------- Stripe (TEST MODE ONLY)
# LiveModeGuard refuses to start unless the key starts with sk_test_ or rk_test_; scripts/up.sh --stripe-test checks it too.

# Secret API key. `local` profile: any sk_test_ value of letters and digits works against stripe-mock (it rejects
# underscores after the prefix). `stripe-test` profile: your real test key (dashboard.stripe.com/test/apikeys); also
# used by the stripe-cli container. scripts/up.sh --stripe-test refuses this placeholder.
STRIPE_API_KEY=sk_test_localdemo

# Publishable key, used by the demo client only (Stripe Elements).
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Webhook signing secret (comma-separated list allowed, for rotation).
# `local`: any whsec_ value, shared with scripts/send-test-webhook.sh.
# `stripe-test`: the secret of the Stripe CLI; scripts/up.sh --stripe-test fetches it when this is still the placeholder, or:
#   docker compose -f infra/docker-compose.yml --env-file .env --profile stripe-test run --rm --no-deps stripe-cli listen --print-secret
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Stripe API base URL for services running ON THE HOST: stripe-mock for `local`, real Stripe for `stripe-test`.
# The containers of the `apps` profile ignore it (compose sets their own; scripts/up.sh --apps --stripe-test switches them).
STRIPE_API_BASE=http://localhost:12111
# STRIPE_API_BASE=https://api.stripe.com

# ----------------------------------------------------------------- Keycloak
# Secret of the confidential client opp-ops-cli (injected into the realm on import; read by scripts/ops-token.sh).
KEYCLOAK_OPS_CLIENT_SECRET=opp-ops-cli-dev-secret
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Password of the dev realm users for scripts/token.sh
OPP_USER_PASSWORD=password

# ----------------------------------------------------------------- PostgreSQL
# Superuser and per-service owners. Init scripts run only on an empty volume: after a change run ./scripts/down.sh -v.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
ORDERS_DB_USER=orders
ORDERS_DB_PASSWORD=orders
PAYMENTS_DB_USER=payments
PAYMENTS_DB_PASSWORD=payments

# ----------------------------------------------------------------- Grafana (observability profile)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
