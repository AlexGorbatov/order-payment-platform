{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.altronixsoft.com/opp/events/PaymentRefunded.v1.json",
  "title": "PaymentRefunded v1",
  "description": "A refund succeeded at the provider.",
  "allOf": [
    {
      "$ref": "envelope.v1.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "PaymentRefunded"
    },
    "eventVersion": {
      "const": 1
    },
    "aggregateType": {
      "const": "Payment"
    },
    "producer": {
      "const": "payment-service"
    },
    "payload": {
      "$ref": "#/$defs/payload"
    }
  },
  "$defs": {
    "payload": {
      "type": "object",
      "required": [
        "paymentId",
        "orderId",
        "refundRequestId",
        "stripeRefundId",
        "amountMinor"
      ],
      "properties": {
        "paymentId": {
          "type": "string",
          "format": "uuid",
          "description": "Payment aggregate id."
        },
        "orderId": {
          "type": "string",
          "format": "uuid",
          "description": "Order the event belongs to; also the Kafka partition key."
        },
        "refundRequestId": {
          "type": "string",
          "format": "uuid",
          "description": "Idempotency id of the refund request."
        },
        "stripeRefundId": {
          "type": "string",
          "minLength": 1,
          "description": "Provider refund id."
        },
        "amountMinor": {
          "type": "integer",
          "minimum": 1,
          "description": "Amount in minor units of the currency (e.g. cents); strictly positive."
        }
      }
    }
  }
}
