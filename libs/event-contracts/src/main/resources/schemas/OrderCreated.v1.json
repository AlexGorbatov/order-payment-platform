{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.altronixsoft.com/opp/events/OrderCreated.v1.json",
  "title": "OrderCreated v1",
  "description": "An order was placed and awaits payment.",
  "allOf": [
    {
      "$ref": "envelope.v1.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "OrderCreated"
    },
    "eventVersion": {
      "const": 1
    },
    "aggregateType": {
      "const": "Order"
    },
    "producer": {
      "const": "order-service"
    },
    "payload": {
      "$ref": "#/$defs/payload"
    }
  },
  "$defs": {
    "payload": {
      "type": "object",
      "required": [
        "orderId",
        "customerId",
        "amountMinor",
        "currency",
        "itemCount"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "format": "uuid",
          "description": "Order the event belongs to; also the Kafka partition key."
        },
        "customerId": {
          "type": "string",
          "minLength": 1,
          "description": "Opaque id of the customer (JWT subject)."
        },
        "amountMinor": {
          "type": "integer",
          "minimum": 1,
          "description": "Amount in minor units of the currency (e.g. cents); strictly positive."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "Upper-case ISO-4217 currency code."
        },
        "itemCount": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of order lines."
        }
      }
    }
  }
}
