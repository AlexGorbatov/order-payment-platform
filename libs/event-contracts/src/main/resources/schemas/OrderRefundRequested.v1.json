{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.altronixsoft.com/opp/events/OrderRefundRequested.v1.json",
  "title": "OrderRefundRequested v1",
  "description": "A refund of a paid order was requested.",
  "allOf": [
    {
      "$ref": "envelope.v1.json"
    }
  ],
  "properties": {
    "eventType": {
      "const": "OrderRefundRequested"
    },
    "eventVersion": {
      "const": 1
    },
    "aggregateType": {
      "const": "Order"
    },
    "producer": {
      "const": "order-service"
    },
    "payload": {
      "$ref": "#/$defs/payload"
    }
  },
  "$defs": {
    "payload": {
      "type": "object",
      "required": [
        "orderId",
        "refundRequestId",
        "amountMinor",
        "currency",
        "reason"
      ],
      "properties": {
        "orderId": {
          "type": "string",
          "format": "uuid",
          "description": "Order the event belongs to; also the Kafka partition key."
        },
        "refundRequestId": {
          "type": "string",
          "format": "uuid",
          "description": "Idempotency id of the refund request."
        },
        "amountMinor": {
          "type": "integer",
          "minimum": 1,
          "description": "Amount in minor units of the currency (e.g. cents); strictly positive."
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "description": "Upper-case ISO-4217 currency code."
        },
        "reason": {
          "enum": [
            "ADMIN",
            "LATE_PAYMENT_AFTER_CANCEL"
          ],
          "description": "Why the refund was requested."
        }
      }
    }
  }
}
