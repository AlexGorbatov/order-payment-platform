<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{30} - %msg%n</pattern>
    </encoder>
  </appender>
  <!-- The services log to their own files; here only the harness speaks, and only when something is off. -->
  <root level="WARN">
    <appender-ref ref="STDOUT"/>
  </root>
  <logger name="org.testcontainers" level="WARN"/>
  <logger name="tc.postgres" level="INFO"/>
</configuration>
